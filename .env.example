# Placeholders only. Never put real secrets in this file or in git.
# Real values live in your local .env (git-ignored) and in Azure Key Vault.

# API login: member of hostpointe_app. Not superuser, not owner, no BYPASSRLS (row-level security applies).
DATABASE_URL=postgresql://hostpointe_api:api_local_only@localhost:5432/hostpointe
# Owner login for migrations only (direct, not pooled, because DDL needs a session). Never used by the running app.
# Shared dev: Neon branch "dev" (D-016 and ADR-0006 supersede D-009 for the database). Real values only in the git-ignored .env; Neon DATABASE_URL uses the "-pooler" host.
MIGRATION_DATABASE_URL=postgresql://hostpointe_owner:owner_local_only@localhost:5432/hostpointe
# pg-boss workers: same API login (hostpointe_api) on the DIRECT host (no -pooler), because advisory locks and LISTEN do not work through the pooler.
WORKER_DATABASE_URL=postgresql://hostpointe_api:api_local_only@localhost:5432/hostpointe
# Backup job only: read-only BYPASSRLS login (hostpointe_backup), direct host. Never used by the app.
BACKUP_DATABASE_URL=postgresql://hostpointe_backup:backup_local_only@localhost:5432/hostpointe
# Audit purge job login (member of hostpointe_purge).
PURGE_DATABASE_URL=postgresql://hostpointe_purge_job:purge_local_only@localhost:5432/hostpointe
NEON_API_KEY=replace-me-project-scoped-key
NEON_PROJECT_ID=replace-me-e.g.-silent-river-12345678
ENTRA_EXTERNAL_ID_TENANT=your-tenant
ENTRA_EXTERNAL_ID_CLIENT_ID=replace-me
AZURE_STORAGE_CONNECTION_STRING=replace-me
ACS_CONNECTION_STRING=replace-me
WHATSAPP_SENDER_ID=replace-me
STRIPE_SECRET_KEY=sk_test_replace_me
PAYSTACK_SECRET_KEY=sk_test_replace_me
A1PAY_API_KEY=replace-me
WEATHER_PROVIDER=open-meteo
QR_SIGNING_KEY=replace-me

# App mode. REQUIRED: the API refuses to start without it (development, test, staging or production).
# Deploy config for every environment must set it explicitly.
APP_ENV=development
# DEMO sign-in: local development only. The API exits if this is "enabled" while APP_ENV=production.
DEMO_SIGNIN=enabled
# 32 or more random characters; placeholder only.
DEMO_SESSION_SECRET=replace-with-32-or-more-random-characters
